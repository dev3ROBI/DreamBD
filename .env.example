# DreamBD Environment Configuration

# Database Settings
DB_HOST=localhost
DB_NAME=dream
DB_USER=root
DB_PASS=

# Security Settings
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# App Settings
APP_DEBUG=true
APP_URL=http://localhost/Dream

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@dreambd.com
