# DreamBD Environment Configuration
# Copy this file to .env and fill in your values

# Database Settings
DB_HOST=localhost
DB_NAME=dream
DB_USER=root
DB_PASS=

# Security Settings
JWT_SECRET=change-this-to-a-random-64-char-hex-string
ENCRYPTION_KEY=change-this-to-a-random-base64-key

# App Settings
APP_DEBUG=true
APP_URL=http://localhost/Dream

# Brevo SMTP Settings
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@email.com
SMTP_PASS=your-xkeysib-xxx-api-key
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Your App Name
